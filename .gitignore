node_modules/
dist/
*.log

# Del arnés de proyecto viaja lo compartible (.claude/settings.json con los
# hooks, .claude/actas); lo local de cada máquina (settings.local.json) y lo
# transitorio de las tiradas, no.
.claude/settings.local.json
.claude/worktrees/
.env
.env.*
.DS_Store
Thumbs.db
scratch/
__pycache__/
*.pyc
.pytest_cache/
mapa*.html
*.map.html
*.html.tmp
nube*.html

# Temporales de las herramientas, en la raiz del repo: pytest (tmp_path), el
# aterrizaje de `gb tests --union` y los mkdtemp de scripts que ponen TMPDIR
# aqui. Sin esta linea ensucian `git status` y, antes del walker que respeta
# .gitignore, entraban al grafo como modulos fantasma — el mismo caso que
# reporto otro repo el 7-ago.
pytest-of-*/
gb-union-*/
tmp*/

# Los proyectos que los bancos se generan a si mismos (bancos/README.md). Se
# regeneran en cada tirada y uno de ellos deja 14 MB de artefactos de cargo:
# nada de eso es del proyecto, pero vive junto al script que lo crea.
bancos/bench-*/
bancos/spike-*/
bancos/cc/

# datos de los oraculos (se regeneran corriendo la suite)
.oraculo.cov*
.oraculo.ini
.oraculo.huella
.oraculo_aristas.json
