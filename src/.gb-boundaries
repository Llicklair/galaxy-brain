# galaxy-brain — invariantes de capas, comprobadas con `gb graph src --gate`.
#
# El NUCLEO (captura, almacen, analisis, hooks, config) no debe importar la
# PRESENTACION. Al reves si: la presentacion se apoya en el nucleo.
#
# Esto eran 45 lineas escritas a mano —el producto cartesiano de 15x3— que decian
# esta unica frase. Con ese coste las fronteras no se escriben, y sobre todo no se
# MANTIENEN: cada modulo nuevo entraba sin regla y nadie se enteraba. Ahora entra
# anadiendo su nombre a la lista de arriba.
#
# Los nombres llevan el prefijo galaxybrain.* porque la raiz del analisis es src/
# (no src/galaxybrain/): asi module_name conserva el paquete.

NUCLEO = galaxybrain.capture, galaxybrain.store, galaxybrain.saferepr,
         galaxybrain.graph, galaxybrain.config, galaxybrain.hooks,
         galaxybrain.changes, galaxybrain.floor, galaxybrain.companions,
         galaxybrain.symbols, galaxybrain.memory, galaxybrain.impacted,
         galaxybrain.delta, galaxybrain.aislado, galaxybrain.actividad

PRESENTACION = galaxybrain.cli, galaxybrain.render, galaxybrain.viz

NUCLEO -/-> PRESENTACION
