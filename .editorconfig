; La gate de formato minima que este repo necesitaba de verdad: toda la sesion
; de hoy avisando LF->CRLF, y la trampa del BOM de Set-Content ya costo ficheros
; corruptos. Esto lo aplican los editores solos; no es decoracion para floor.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_size = 2
