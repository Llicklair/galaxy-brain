{
  "permissions": {
    "allow": [
      "Bash(python -m pytest tests/ -q)",
      "Bash(gb graph *)",
      "Bash(gb tests *)",
      "Bash(python -m pytest tests/ -q --tb=no -p no:cacheprovider)",
      "Bash(gb check *)",
      "Bash(gb delta *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gb graph --context",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
